{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "red",
      "2": "red"
    }
  },
  "display": {
    "color": {
      "keys": "red"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "red"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "󰔟 Uptime",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "red"
    },
    {
      "type": "wmtheme",
      "key": "󰉼 Theme",
      "keyColor": "red"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "red"
    },
    {
      "type": "font",
      "key": "󰛖 Font",
      "keyColor": "red"
    },
    {
      "type": "cursor",
      "key": "󰇀 Cursor",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "red"
    },
    {
      "type": "terminalfont",
      "key": "󰛖 Terminal Font",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "red"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "keyColor": "red"
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "keyColor": "red"
    },
    {
      "type": "locale",
      "key": " Locale",
      "keyColor": "red"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}

